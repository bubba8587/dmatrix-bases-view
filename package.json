{
	"name": "decision-matrix-bases-view",
	"version": "0.8.0",
	"description": "A weighted decision matrix view for Bases. Score notes across criteria with a Solenoid Properties Weights frame and see them ranked.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test 'tests/*.test.ts'",
		"deploy": "bash deploy.sh",
		"parity": "node scripts/parity.mjs",
		"lint": "eslint src",
		"e2e": "node scripts/e2e/rig.mjs run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"decision-matrix",
		"bases",
		"weighted-scoring"
	],
	"author": "jortscity",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^22.0.0",
		"esbuild": "0.24.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.1",
		"puppeteer-core": "^24.43.1",
		"tslib": "2.8.0",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.70.1"
	}
}
